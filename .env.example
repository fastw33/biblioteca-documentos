NODE_ENV=development
HOST=127.0.0.1
PORT=3016
TRUST_PROXY_HOPS=0
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=repositorio_documentos
# Exactamente el mismo secreto de wmsBack. Nunca exponerlo en VITE_*.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=genika-repositorio-documentos
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=documentos
INITIALIZE_STORAGE_ON_START=false
MAX_FILE_MB=30
LIBREOFFICE_PATH=soffice
PDFTOPPM_PATH=pdftoppm
PREVIEW_TIMEOUT_MS=60000
