{
  "name": "genika-repositorio-documentos",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca corporativa con MongoDB, S3 y JWT de WMS",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "config:genika": "node scripts/configure-genika.js",
    "setup": "node --env-file=.env scripts/provision.js",
    "test": "node --test --test-concurrency=1",
    "test:live": "node --env-file=.env scripts/live-check.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "buffer-crc32": "^1.0.0",
    "content-disposition": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4"
  }
}
