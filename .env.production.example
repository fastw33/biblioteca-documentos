# En Coolify, RAILPACK_NODE_VERSION debe estar disponible durante la compilación.
# coolify: runtime=false
RAILPACK_NODE_VERSION=24
NODE_ENV=production
HOST=0.0.0.0
PORT=3016
TRUST_PROXY_HOPS=1
# coolify: literal buildtime=false
MONGO_URI=mongodb://USUARIO:CLAVE_CODIFICADA@HOST_MONGO:27017/repositorio_documentos?authSource=admin
MONGO_DB_NAME=repositorio_documentos
# coolify: literal buildtime=false
JWT_SECRET=SECRETO_WMS_EXISTENTE
CORS_ORIGINS=https://portalclientes.fastwaysas.com,https://www.appfastway.com,https://qa.appfastway.com
AWS_REGION=us-east-1
# coolify: literal buildtime=false
AWS_ACCESS_KEY_ID=CREDENCIAL_S3_EXISTENTE
# coolify: literal buildtime=false
AWS_SECRET_ACCESS_KEY=CLAVE_S3_EXISTENTE
# coolify: literal buildtime=false
AWS_SESSION_TOKEN=
S3_BUCKET=genika-repositorio-documentos
S3_ENDPOINT=http://HOST_MINIO:9000
S3_FORCE_PATH_STYLE=true
S3_PREFIX=documentos
# Crea únicamente el bucket configurado si no existe, al iniciar la API.
INITIALIZE_STORAGE_ON_START=true
MAX_FILE_MB=30
LIBREOFFICE_PATH=soffice
PDFTOPPM_PATH=pdftoppm
PREVIEW_TIMEOUT_MS=60000
